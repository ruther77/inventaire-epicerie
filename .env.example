# ---------------------------------------------------------------------------
# Base application configuration shared across development environments.
# Copy this file to `.env` and adjust the values before starting the stack.
# ---------------------------------------------------------------------------

# --- Application secrets ---------------------------------------------------
# Authentication secret used by Streamlit and the FastAPI backend to sign JWTs.
# Must contain at least 32 characters.
AUTH_SECRET_KEY=replace_with_32_chars_min_secret

# Allowed origins for the FastAPI CORS middleware.
API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Access token expiration in minutes (default: 120).
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- Database --------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=epicerie
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/epicerie

# Connection pool tuning (optional overrides)
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_MAX_OVERFLOW=20

# --- Streamlit -------------------------------------------------------------
STREAMLIT_SERVER_PORT=8501

# --- Misc ------------------------------------------------------------------
# E-mail used when requesting certificates (reverse proxy, etc.)
LE_EMAIL=contact@example.com
SITE_DOMAIN=localhost

# ---------------------------------------------------------------------------
# Production-oriented configuration template. Copy to `.env` and adjust.
# ---------------------------------------------------------------------------

# --- Domain & certificates --------------------------------------------------
SITE_DOMAIN=example.com
LE_EMAIL=ops@example.com

# --- Database ---------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=epicerie
DATABASE_URL=postgresql+psycopg2://postgres:change_me@db:5432/epicerie
SQLALCHEMY_POOL_SIZE=20
SQLALCHEMY_MAX_OVERFLOW=40

# --- Application secrets ----------------------------------------------------
AUTH_SECRET_KEY=please_generate_a_64_char_secret
API_ALLOWED_ORIGINS=https://app.example.com,https://api.example.com
ACCESS_TOKEN_EXPIRE_MINUTES=120
AUTH_PBKDF2_ITERATIONS=390000
AUTH_PASSWORD_ALGORITHM=sha256
AUTH_PASSWORD_SALT_BYTES=16

# --- Streamlit --------------------------------------------------------------
STREAMLIT_SERVER_PORT=8501

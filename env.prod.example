# ---------------------------------------------------------------------------
# Production-oriented configuration template. Copy to `.env` and adjust.
# ---------------------------------------------------------------------------

# --- Domain & certificates --------------------------------------------------
SITE_DOMAIN=example.com
LE_EMAIL=ops@example.com

# --- Database ---------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=epicerie
DATABASE_URL=postgresql+psycopg2://postgres:change_me@db:5432/epicerie
SQLALCHEMY_POOL_SIZE=20
SQLALCHEMY_MAX_OVERFLOW=40

# ---------- App ----------
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/epicerie
# Schéma(s) à placer dans le search_path PostgreSQL (ex: inventory,public)
DATABASE_SEARCH_PATH=public
AUTH_SECRET_KEY=replace_with_32_chars_min_secret

# --- Streamlit --------------------------------------------------------------
STREAMLIT_SERVER_PORT=8501
